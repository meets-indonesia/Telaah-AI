# Market data source: "open" (default, no key) or "sectors" (legacy, needs a key)
MARKET_DATA_PROVIDER=open

# Optional: legacy Sectors API (only when MARKET_DATA_PROVIDER=sectors)
SECTORS_API_KEY=

# OpenRouter untuk synthesis dan embedding semantic cache
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Opsional
OPENROUTER_MODEL=qwen/qwen3.5-397b-a17b
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
# Server-side refresh for the chart stream while a browser is watching
CHART_STREAM_REFRESH_MS=5000
# App-level abuse guard. Cloudflare Access should still protect the hostname.
# Set to false only while debugging locally.
RATE_LIMIT_ENABLED=true

# Watchlist alerts (Telegram + local cron)
ALERT_SECRET=
ALERT_WATCHLIST_FILE=data/alert_watchlist.json


# Telegram research companion (personal use, optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_BRIEF_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_URL=https://telaah.hiiamanop.my.id

# Secret for the local harmonic-brief endpoint (host cron)
BRIEF_SECRET=

# Phase 2 IDX scraper (Podman pod service)
SCRAPER_URL=http://127.0.0.1:8001
SCRAPER_BROKER_SUMMARY_ENABLED=false
STOCKBIT_ENABLED=false

# Stockbit broker summary (optional, personal session)
STOCKBIT_SESSION_FILE=/app/data/stockbit_session.json
